SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
GROQ_API_KEY=your_groq_api_key
# Optional but recommended: a dedicated Groq key for username moderation so its
# quota is fully isolated from gameplay explanation/hint calls (GROQ_API_KEY).
# If unset, falls back to GROQ_API_KEY.
GROQ_MODERATION_KEY=your_groq_moderation_key
# Set to false/off/0/no to allow public lobby usernames without moderation.
USERNAME_MODERATION_ENABLED=true
OPENF1_BASE_URL=https://api.openf1.org/v1
# Required during live F1 sessions when SignalR auth is unavailable (https://openf1.org)
OPENF1_API_KEY=
# Optional — only needed if F1 starts requiring auth on /signalrcore (FastF1 f1auth flow)
F1_LIVE_TIMING_TOKEN=
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://motorsport-iq.vercel.app
PRESENCE_DISCONNECT_GRACE_MS=120000
PRESENCE_INACTIVITY_TIMEOUT_ACTIVE_MS=10800000
PRESENCE_INACTIVITY_TIMEOUT_WAITING_MS=600000
PRESENCE_DB_WRITE_MIN_INTERVAL_MS=300000
MAX_PLAYERS_PER_LOBBY=30
MAX_ACTIVE_LOBBIES=500
STALE_LOBBY_TIMEOUT_MS=600000
STALE_LOBBY_SWEEP_INTERVAL_MS=300000
LOBBY_LAP_CONCURRENCY=20
FF_BATCH_SCORING=true
FF_PRESENCE_WRITE_THROTTLE=true
FF_DELTA_LOBBY_STATE=true
FF_REDIS_ADAPTER=false
FF_JOB_QUEUE=false
REDIS_URL=
SIMULATION_ENABLED=false
SIMULATION_SPEED=1
# Delay live telemetry + question triggers to align with F1 TV (~20s broadcast + SignalR lead). 0 = off.
LIVE_BROADCAST_DELAY_MS=22000
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_INITIAL_PASSWORD_HASH=
# Web Push (optional) — generate with: npx web-push generate-vapid-keys
# Also run backend/schema/migration_push_notifications.sql in Supabase.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by push services (mailto: or https:)
VAPID_SUBJECT=mailto:hello@motorsport-iq.vercel.app
